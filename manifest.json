  "shortcuts": [
    {
      "name": "RSVP",
      "short_name": "RSVP",
      "description": "Submit your RSVP for the wedding",
      "url": "./index.html#rsvp",
      "icons": [
        {
          "src": "./icons/rsvp-icon.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Gallery",
      "short_name": "Gallery",
      "description": "View wedding photos and memories",
      "url": "./index.html#gallery",
      "icons": [
        {
          "src": "./icons/gallery-icon.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Events",
      "short_name": "Events",
      "description": "Wedding ceremony details and schedule",
      "url": "./index.html#events",
      "icons": [
        {
          "src": "./icons/events-icon.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "./share-handler.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "photos",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+wedding",
      "url": "./index.html?invite=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".gif", ".webp"]
      }
    }
  ],
  "id": "bengali-wedding-invitation",
  "iarc_rating_id": "",
  "permissions": ["notifications", "background-sync"],
  "features": ["cross-origin-isolated"]
}
